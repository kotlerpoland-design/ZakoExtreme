{
  "name": "zakoextreme",
  "version": "0.1.0",
  "private": true,
  "description": "Nowa strona ZakoExtreme (Zakopane) — Next.js, PL/EN, sezonowa, mobile-first",
  "scripts": {
    "dev": "next dev --turbopack -p 3006",
