# Publiczny adres strony (bez końcowego ukośnika). Używany w canonical, hreflang, sitemap, schema.
NEXT_PUBLIC_SITE_URL=https://zakoextreme.pl

# Google Tag Manager — DOKŁADNIE jeden kontener. Nie GTM-T3PTPJ4K, nie GTM-KGM2CNF4.
# Pusty = tagi nie ładują się (dev). Wartość produkcyjna: docs/pakiet/05-TRACKING.md §2.
NEXT_PUBLIC_GTM_ID=

# SlotWise — istniejący system rezerwacji (docs/pakiet/01-BRIEF-I-FAKTY.md §2).
NEXT_PUBLIC_SLOTWISE_BUSINESS_ID=

# Ręczne nadpisanie sezonu: winter | shoulder | summer. Pusty = z dat w config/season.ts.
NEXT_PUBLIC_SEASON_OVERRIDE=
